{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose port:*)",
      "Bash(docker compose --profile test up -d:*)",
      "Bash(docker compose exec php php vendor/bin/phpunit:*)",
      "Bash(docker compose exec php_test php vendor/bin/phpunit:*)",
      "Bash(docker compose exec php_cms php vendor/bin/phpunit:*)",
      "Bash(docker compose exec php php vendor/bin/phinx status:*)",
      "Bash(docker compose exec php php vendor/bin/phinx migrate:*)",
      "Bash(docker compose exec php php vendor/bin/phinx create:*)",
      "Bash(docker compose exec php php -l:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "PowerShell(docker compose ps:*)",
      "PowerShell(docker compose up -d:*)",
      "PowerShell(docker compose exec php php vendor/bin/phpunit:*)",
      "PowerShell(docker compose exec php_test php vendor/bin/phpunit:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "PowerShell(docker compose down -v:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Write(./.env)",
      "Edit(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-instructions.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-instructions.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

{
    "name": "vanveluwlaserdesign/webshop",
    "description": "Mygdala: a PHP/MySQL CMS with an optional webshop, personalization and blog module",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16",
        "mollie/mollie-api-php": "^3.13",
        "phpmailer/phpmailer": "^6.9",
        "ezyang/htmlpurifier": "^4.18",
        "smalot/pdfparser": "^2.12",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}

# Block direct web access to files/folders that should never be served,
# both locally and once this is deployed to Vimexx shared hosting.

# Public pages are now PHP (see partials/ for the shared header/footer);
# make sure / resolves to index.php regardless of the host's own default.
# The rewrite below routes "/" through dispatcher.php before this is reached;
# it stays as the safety net for a server that ignores mod_rewrite.
DirectoryIndex index.php index.html

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|phinx\.php)$">
    Require all denied
</FilesMatch>

# The release metadata the self-updater reads (docs/updates/ARCHITECTURE.md):
# the exact version and the hash of every Core file are nobody's business but
# this installation's, and the maintenance flag names the running update.
<FilesMatch "^(VERSION|release\.json|\.maintenance)$">
    Require all denied
</FilesMatch>

RewriteEngine On
# "storage" here is defense-in-depth, not the actual protection: contact
# request attachments are stored one directory ABOVE the project root by
# default (see src/Service/ContactAttachmentStorage.php), so there is no
# project-root storage/ folder to serve in the first place. This entry only
# guards against a future project-root-relative storage/ path.
RewriteCond %{REQUEST_URI} ^/(vendor|db|src|docker|storage)(/|$) [NC]
RewriteRule ^ - [F,L]

# XML sitemap: /sitemap.xml is generated by sitemap.php from the database on
# every request (see App\Service\Sitemap). Crawlers and robots.txt keep the
# conventional .xml URL — nothing outside this one line knows a PHP file is
# behind it. There used to be a hand-maintained static sitemap.xml here; it
# listed 5 URLs, contained nothing from the shop, and had no way of noticing
# a new product, a new collection or a newly published page.
#
# The sitemap is one document for the whole site, with every language version
# of a page as an alternate inside it (docs/multilingual/ROUTING.md), so it
# has no language-prefixed form and is matched here, ahead of the dispatcher.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# robots.txt: generated by robots.php for the same reason the sitemap is.
# The static file that used to sit here typed the production domain into its
# Sitemap: line, so a second deployment of this codebase advertised somebody
# else's sitemap; the URL now comes from APP_URL like every canonical tag
# does (see App\Service\Robots). The file itself is gone, so nothing can be
# served from disk if this rule is ever removed by accident — a missing
# robots.txt is a well-understood "crawl everything", not a wrong one.
RewriteRule ^robots\.txt$ robots.php [L]

# TECHNICAL NAMESPACES NEVER REACH THE DISPATCHER. A real file under these
# paths is served by Apache as always; a MISSING one must answer like the
# machine route it is (404.php's terse "404 Not Found"), not be handed to a
# router that would build the site's whole shell — navigation, footer, theme,
# every query behind them — for a stray /assets/... request nobody reads.
# "-" means "leave the URL alone", so these fall through to ErrorDocument.
RewriteCond %{REQUEST_URI} ^/(admin|api|assets|uploads|docs|partials|scripts|tests)(/|$) [NC]
RewriteRule ^ - [L]

# THE SITE ROOT goes through the dispatcher like every other public URL: it is
# where a visitor who has named no language is offered the one they asked for
# (docs/multilingual/ROUTING.md). REQUEST_FILENAME for "/" is the document
# root itself, which the -d check below would skip, so it needs its own line.
RewriteRule ^$ dispatcher.php [L,QSA]

# EVERY OTHER PUBLIC URL. This one rule replaces the seven narrow rewrites
# and the single-segment CMS-page catch-all that used to stand here
# (/portfolio/<slug>, /collecties/<slug>, the five /blog/... rules and
# ^([a-z0-9-]+)/?$). They were removed rather than extended because a URL with
# a language prefix has at least two segments, and every one of those rules
# would have needed a copy PER LANGUAGE — in a static file, for a list of
# languages that lives in a database table and changes at runtime.
#
# Route knowledge now lives in App\Service\Routing\RouteTable: a closed list
# in code, with tests, instead of a file nothing can test. Adding a route is a
# line there and no change here.
#
# The two conditions are what keep this from swallowing anything real, and
# they are the same filesystem checks the old catch-all used:
#   - `!-f` — an existing file wins. Every root-level template
#     (index.php, shop.php, product.php, cart.php, ...), every asset and every
#     admin or API endpoint keeps being served straight off disk, byte for
#     byte as before. That is also the emergency hatch if this rule is ever
#     wrong: the real files stay reachable.
#   - `!-d` — an existing top-level directory is Apache's business, not this
#     application's.
# Both are self-maintaining as files and folders come and go.
#
# Note what this means for existing URLs: /shop.php is a file and is answered
# exactly as it always was, while /en/shop.php is not a file and arrives at
# the dispatcher, which peels the language off and requires the same template.
# No canonical URL of an existing site moves.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ dispatcher.php [L,QSA]

# Everything Apache itself could not resolve ends here: a request under one of
# the technical namespaces above, or one for a directory that has no index.
#
# 404.php uses that moment for two things, in this order: it asks the Redirect
# Manager whether this URL was moved (App\Service\Redirects\RedirectGate, see
# REDIRECTS.md) and otherwise renders the site's own "Pagina niet gevonden"
# document with a real 404 status, instead of Apache's stock error page.
#
# This can never shadow a working URL: Apache only reaches an ErrorDocument
# once it has established that nothing serves the request.
ErrorDocument 404 /404.php

<!--
    Test suites for this project. TESTING.md explains when to run which.

    Two things to know before editing:

    1. tests/bootstrap.php forces every database connection onto the TEST
       database and refuses to start if it cannot. No test connects to the
       development database, whichever suite it runs in.

    2. A test file may appear in more than one suite — "blocks" and "http"
       overlap on purpose, for instance. The default suite is "full", so a
       plain `phpunit` still runs everything exactly once.

    Adding a test? Put it in the domain suite it belongs to (blocks / cms /
    shop / personalization / analytics) plus, if it applies, one of unit,
    contract or http. Tests\Architecture\TestSuiteCoverageTest fails if a
    test file is left out of every domain suite, so this list cannot quietly
    fall behind.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         defaultTestSuite="full"
         colors="true">
    <testsuites>
        <!-- ============================================================
             Tiers: how a test runs (speed, and what it needs to exist)
             ============================================================ -->

